DB_NAME=campusdesk
DB_URL=jdbc:postgresql://localhost:5432/campusdesk
DB_USERNAME=campusdesk
DB_PASSWORD=replace-with-a-local-development-password
DB_DRIVER_CLASS_NAME=org.postgresql.Driver
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=3600000
CORS_ALLOWED_ORIGINS=http://localhost:5173
SERVER_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
ADMIN_USERNAME=replace-with-a-production-admin-username
ADMIN_EMAIL=replace-with-a-production-admin-email
ADMIN_FULL_NAME=CampusDesk Administrator
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters
